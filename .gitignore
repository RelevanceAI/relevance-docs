/env/
/.vscode/
.env
node_modules/
# Scoped to the repo root. These were bare patterns, which git matches at ANY
# depth -- so site/package.json and site/package-lock.json were silently never
# committed, and the docs site could not be built from a clean checkout.
# Vercel cloned the repo, found no manifest, skipped install, and failed with
# "next: command not found".
/package-lock.json
/package.json

# Local documentation guidelines
DOCS_DONT.md

# Generated by site/tools/optimize-images.mjs on every build.
site/public/images/_opt/
site/lib/image-manifest.json
